{
  "name": "@vaia-lab/sdk",
  "version": "0.2.0",
  "description": "VAIA SDK — platform integration for Gandia-7 and Handeia developers",
  "author": "VAIA <hello@vaia.dev>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "vaia-sdk": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "vaia",
    "gandia",
    "handeia",
    "sdk",
    "platform",
    "ai",
    "institutional"
  ],
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
